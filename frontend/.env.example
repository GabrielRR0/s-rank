VITE_API_BASE_URL=

# Turnstile (captcha invisible de Cloudflare), apagado por defecto - ver
# backend/.env.example y backend/README.md seccion 11. Con
# VITE_TURNSTILE_ENABLED distinto de "true" (o sin definir), el widget ni
# se monta ni se carga el script de Cloudflare.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# Chat secreto S-Rank (ver src/services/secretChat/README.md): primer uso
# de Supabase directo desde el frontend en este proyecto, necesario para
# Realtime Broadcast/Presence (no se puede usar desde el backend). Va la
# anon key (publica por diseno, protegida por RLS del lado de las tablas
# que si importan) - NUNCA la service_role key que usa backend/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
