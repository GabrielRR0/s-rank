SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=shared-content
FRONTEND_URL=
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_CREATE=10/minute
RATE_LIMIT_STATUS=30/minute
RATE_LIMIT_REVEAL=5/minute
MAX_BODY_BYTES=10500000
MAX_FILE_BYTES=10000000

# Generar con: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=
SHARE_PASSWORD_MAX_ATTEMPTS=8

# Turnstile (captcha invisible de Cloudflare) en la creacion de shares.
# Apagado por defecto - el proyecto depende del rate limiting y el resto
# del hardening. Para activarlo: TURNSTILE_ENABLED=true + la secret key de
# tu widget de Cloudflare (y VITE_TURNSTILE_ENABLED/SITE_KEY del lado del
# frontend, ver frontend/.env.example).
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# secretVault (Cofre del chat secreto S-Rank) - mismo proyecto/credenciales
# de Supabase que arriba, sin variables nuevas de conexion. Ver
# backend/README.md seccion "Cofre del chat secreto" para el SQL de la
# tabla secret_vault_items y la funcion decrement_vault_copies.
RATE_LIMIT_VAULT_CREATE=20/minute
RATE_LIMIT_VAULT_STATUS=60/minute
RATE_LIMIT_VAULT_COPY=30/minute
VAULT_MAX_CIPHERTEXT_BYTES=8000

# secretChatAuth: autoriza quien puede usar los canales de Supabase
# Realtime del chat (Broadcast/Presence) - ver backend/README.md seccion 13.
#
# Project Settings -> API -> JWT Settings -> "JWT Secret" (formato legacy
# HS256). DISTINTO de SUPABASE_KEY (service_role) y de
# MASTER_ENCRYPTION_KEY - nunca exponer al frontend. Sin default a
# proposito: si falta, mintear un token debe fallar explicito (500).
SUPABASE_JWT_SECRET=
REALTIME_ACCESS_TTL_SECONDS=300
REALTIME_SESSION_TTL_SECONDS=2700
SECRET_CHAT_ROOM_TTL_SECONDS=604800
RATE_LIMIT_REALTIME_ROOMS=10/minute
RATE_LIMIT_REALTIME_TOKEN=20/minute
RATE_LIMIT_REALTIME_REFRESH=60/minute
BOT_GUARD_MAX_FAILURES=5
BOT_GUARD_WINDOW_SECONDS=600
BOT_GUARD_BLOCK_SECONDS=1800
