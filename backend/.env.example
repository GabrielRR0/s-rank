SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=shared-content
FRONTEND_URL=
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_CREATE=10/minute
RATE_LIMIT_STATUS=30/minute
RATE_LIMIT_REVEAL=5/minute
MAX_BODY_BYTES=10500000
MAX_FILE_BYTES=10000000

# Generar con: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=
SHARE_PASSWORD_MAX_ATTEMPTS=8

# Turnstile (captcha invisible de Cloudflare) en la creacion de shares.
# Apagado por defecto - el proyecto depende del rate limiting y el resto
# del hardening. Para activarlo: TURNSTILE_ENABLED=true + la secret key de
# tu widget de Cloudflare (y VITE_TURNSTILE_ENABLED/SITE_KEY del lado del
# frontend, ver frontend/.env.example).
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
